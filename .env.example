# International WhatsApp number: digits only, without +, spaces, or punctuation.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional studio Instagram profile URL. The footer link appears only when configured.
NEXT_PUBLIC_INSTAGRAM_URL=
# Required before deploying: set the canonical production origin, without a trailing slash.
# On GitHub Pages this includes the repository path, because project sites are
# served from a subpath: https://souhib-khalbous.github.io/daa-wa-zekaa
# When empty, local development uses http://localhost:3000. A build with
# GITHUB_PAGES=true fails rather than falling back, so canonical tags, hreflang
# and Open Graph never ship pointing at localhost.
NEXT_PUBLIC_SITE_URL=
